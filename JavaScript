    // ==========================================
    // 🌟 EXPORT TO WORD
    // ==========================================
    function exportToWord() {
        var content = document.getElementById('docViewer').innerHTML;
        if (!content || content.trim() === "") return alert("No document content to export!");
        var tempDiv = document.createElement('div'); tempDiv.innerHTML = content;
        var allImgs = tempDiv.getElementsByTagName('img');
        for(var k = 0; k < allImgs.length; k++) { allImgs[k].style.width = '100%'; allImgs[k].style.maxWidth = '600px'; allImgs[k].style.height = 'auto'; allImgs[k].setAttribute('width', '600'); }
        var fileIds = []; var idToImgMap = {};
        for(var i = 0; i < allImgs.length; i++) {
            var src = allImgs[i].src; var match = src.match(/id=([a-zA-Z0-9_-]+)/);
            if(match) { var id = match[1]; if(fileIds.indexOf(id) === -1) fileIds.push(id); if(!idToImgMap[id]) idToImgMap[id] = []; idToImgMap[id].push(allImgs[i]); }
        }
        if(fileIds.length === 0) { finalizeWordExport(tempDiv.innerHTML); return; }
        var btn = document.querySelector('button[onclick="exportToWord()"]'); var originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Packing Images...'; btn.disabled = true; showToast("Processing embedded images for Word...", "bg-dark");
        google.script.run.withSuccessHandler(function(base64Data) {
            for(var id in base64Data) { if(base64Data[id]) { idToImgMap[id].forEach(function(imgEl) { imgEl.src = base64Data[id]; }); } }
            btn.innerHTML = originalText; btn.disabled = false; finalizeWordExport(tempDiv.innerHTML); 
        }).withFailureHandler(function(err) {
            btn.innerHTML = originalText; btn.disabled = false; alert("Failed to process some images: " + err.message); finalizeWordExport(tempDiv.innerHTML); 
        }).getBase64FromDrive(fileIds);
    }

    function finalizeWordExport(htmlContent) {
        var css = '<style>@page WordSection1 { size: 595.3pt 841.9pt; margin: 54.0pt 54.0pt 54.0pt 54.0pt; } div.WordSection1 { page: WordSection1; font-family: "TH SarabunPSK", "Sarabun", "Tahoma", sans-serif; font-size: 16pt; } p, span, td, th, div { font-family: "TH SarabunPSK", "Sarabun", "Tahoma", sans-serif; font-size: 16pt; } table { border-collapse: collapse; width: 100% !important; table-layout: fixed; } td, th { border: 1px solid black; padding: 5px; word-wrap: break-word; } img { max-width: 100%; height: auto; }</style>';
        var header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta http-equiv='Content-Type' content='text/html; charset=utf-8'><title>" + window.currentViewTitle + "</title>" + css + "</head><body><div class='WordSection1'>";
        var footer = "</div></body></html>";
        var sourceHTML = header + htmlContent + footer;
        var source = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent('\ufeff' + sourceHTML);
        var fileDownload = document.createElement("a"); document.body.appendChild(fileDownload); fileDownload.href = source; fileDownload.download = window.currentViewTitle + '.doc'; fileDownload.click(); document.body.removeChild(fileDownload); showToast("Exported to Word successfully!", "bg-success");
    }
