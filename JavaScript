    function initTinyMCE() {
        tinymce.init({
            selector: '#tinymce-editor', height: 500, plugins: 'table image link lists code',
            toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist | table insertAuditTable | link image customFileBtn | code',
            menubar: false, branding: false, promotion: false,
            table_toolbar: 'tableprops tabledelete | tableinsertrowbefore tableinsertrowafter tabledeleterow | tableinsertcolbefore tableinsertcolafter tabledeletecol | tablecellbackgroundcolor tablecellbordercolor',
            content_style: "body { font-family:Inter,sans-serif; font-size:14px } td, th { vertical-align: top !important; }",
            setup: function (editor) {
                editor.ui.registry.addButton('insertAuditTable', {
                    icon: 'new-document', tooltip: 'แทรกตาราง Audit หัว 2 ชั้น',
                    onAction: function () {
                        editor.insertContent(`<table style="width: 100%; border-collapse: collapse; text-align: center; font-family: 'Inter', sans-serif;" border="1"><thead><tr style="background-color: #0033a0; color: #ffffff;"><th rowspan="2" style="width: 8%; padding: 12px; border: 1px solid #444;">No.</th><th rowspan="2" style="width: 42%; padding: 12px; border: 1px solid #444;">Audit Checklist / Detail</th><th colspan="2" style="width: 30%; padding: 8px; border: 1px solid #444;">Evaluation Result</th><th rowspan="2" style="width: 20%; padding: 12px; border: 1px solid #444;">Remarks / Note</th></tr><tr style="background-color: #e9ecef; color: #333333;"><th style="width: 15%; padding: 8px; border: 1px solid #444;">Status (Pass/Fail)</th><th style="width: 15%; padding: 8px; border: 1px solid #444;">Score</th></tr></thead><tbody><tr><td style="padding: 10px; border: 1px solid #ccc;">1</td><td style="text-align: left; padding: 10px; border: 1px solid #ccc;">รายละเอียดการตรวจสอบรายการที่ 1...</td><td style="padding: 10px; border: 1px solid #ccc;"></td><td style="padding: 10px; border: 1px solid #ccc;"></td><td style="padding: 10px; border: 1px solid #ccc;"></td></tr></tbody></table><p><br></p>`);
                    }
                });
                editor.ui.registry.addButton('customFileBtn', {
                    icon: 'upload', tooltip: 'Upload Document / File',
                    onAction: function () {
                        var input = document.createElement('input'); input.setAttribute('type', 'file');
                        input.onchange = function () {
                            var file = this.files[0]; if (!file) return;
                            var uniqueId = 'upload-placeholder-' + new Date().getTime();
                            editor.insertContent(`<span id="${uniqueId}" style="background-color: #f8f9fa; border: 1px dashed #adb5bd; color: #6c757d; padding: 4px 12px; border-radius: 20px; font-size: 0.9em; font-style: italic; display: inline-block; margin: 2px 4px; vertical-align: middle;" contenteditable="false">⏳ กำลังอัปโหลด: ${file.name}...</span>`);
                            showToast("Uploading file to document...", "bg-dark");
                            var reader = new FileReader(); reader.readAsDataURL(file);
                            reader.onload = function () {
                                google.script.run.withSuccessHandler(function(url) {
                                    var linkHtml = `<a href="${url}" target="_blank" rel="noopener noreferrer" contenteditable="false" style="background-color: #e0f2fe; border: 1px solid #7dd3fc; color: #0369a1; padding: 4px 12px; border-radius: 20px; font-size: 0.9em; font-weight: 600; display: inline-block; cursor: pointer; margin: 2px 4px; vertical-align: middle; text-decoration: none;" title="View Attached File">📎 ${file.name}</a>&nbsp;`;
                                    var edDoc = editor.getDoc(); var pNode = edDoc.getElementById(uniqueId);
                                    if (pNode) pNode.outerHTML = linkHtml; else editor.insertContent(linkHtml);
                                    showToast("File inserted successfully!", "bg-success");
                                }).withFailureHandler(function(error) {
                                    var edDoc = editor.getDoc(); var pNode = edDoc.getElementById(uniqueId);
                                    if (pNode) pNode.outerHTML = `<span style="color: #dc3545; font-size: 0.9em;">❌ Upload Failed: ${file.name}</span>`;
                                    alert("Upload failed: " + error.message);
                                }).uploadMediaToDrive(reader.result, file.name, false);
                            };
                        }; input.click();
                    }
                });
            }
        });
    }

